# Copy thành .env (hoặc khai báo trong Run Configuration của IntelliJ) và điền giá trị thật.
DB_PASSWORD=
# Chuỗi ngẫu nhiên >= 32 byte, tạo bằng: openssl rand -base64 48
JWT_SECRET=
DEV_HR_EMAIL=
DEV_HR_PASSWORD=
# Tùy chọn: chỉ đặt false nếu trình duyệt dev không lưu cookie Secure trên http://localhost
# JWT_COOKIE_SECURE=false
